# WAVY Backend Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# Database Configuration (MySQL 8+ / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wavy_db
DB_USER=root
DB_PASSWORD=

# CORS & Server Host
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=*

# Location / City Default
DEFAULT_CITY=Hyderabad
DEFAULT_LAT=17.3850
DEFAULT_LNG=78.4867

